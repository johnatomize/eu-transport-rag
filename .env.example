# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Each checkpoint adds the variables it needs, with a comment saying which one.

# Checkpoint A: local Postgres + pgvector (docker-compose.yml). Pick any password; it stays local.
# The user and password are applied only when the data volume is first created. To change them
# later, delete the volume and its data: docker compose down -v
# Change POSTGRES_PORT if something else on this machine already listens on 5432.
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag
POSTGRES_PORT=5432

# Checkpoint F: Claude answers through Anthropic's API (make answers RUN=1, make ask). Create a key
# on the Anthropic Console (API keys page) and paste it here, never in chat or a commit. Set a
# spend limit on the Console's Billing page first. Only paid runs read it.
ANTHROPIC_API_KEY=

# Checkpoint G, #99: Jev (TypeSafe AI) as a hosted reranker (make rerank WITH=jev RUN=1). Create a
# key on TypeSafe's developer console (console.typesafe.ai) and paste it here, never in chat or a
# commit. Only paid runs read it.
TYPESAFE_API_KEY=
