# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Each checkpoint adds the variables it needs, with a comment saying which one.

# Checkpoint A: local Postgres + pgvector (docker-compose.yml). Pick any password; it stays local.
# The user and password are applied only when the data volume is first created. To change them
# later, delete the volume and its data: docker compose down -v
# Change POSTGRES_PORT if something else on this machine already listens on 5432.
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag
POSTGRES_PORT=5432
